[Unit]
Description=Income Model Inference Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tomthecat
WorkingDirectory=/home/tomthecat
Environment=ARTIFACT_BUCKET=dragon-raja-505509-mlops-day21
ExecStart=/home/tomthecat/venv/bin/uvicorn src.serve:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
